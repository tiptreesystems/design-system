{
  "name": "@tiptree/design-system",
  "version": "0.2.0",
  "private": false,
  "description": "Tiptree design system — tokens, per-component CSS, and markup contracts. CSS is the contract; bindings are conveniences.",
  "type": "module",
  "files": [
    "dist/css/",
    "dist/manifest.json",
    "specs/",
    "themes/"
  ],
  "exports": {
    "./components/*.css": "./dist/css/components/*.css",
    "./layered/components/*.css": "./dist/css/layered/components/*.css",
    "./primitives.css": "./dist/css/primitives.css",
    "./themes/*.css": "./dist/css/themes/*.css",
    "./manifest.json": "./dist/manifest.json",
    "./tokens.css": "./dist/css/tokens.css",
    "./tt.css": "./dist/css/tt.css"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-tokens.mjs",
    "test:node": "node --test tests/*.test.mjs",
    "test:python": "node scripts/test-python.mjs",
    "test": "npm run test:node && npm run test:python",
    "budgets": "node scripts/build-tokens.mjs && node scripts/budgets.mjs",
    "ci": "node scripts/build-tokens.mjs && npm run test:node && npm run test:python && node scripts/budgets.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
